# Local Config Presets for Nest Server
# Location: plugins/configs/local-presets.conf
# Format: <key>=<command> <param1>=<value1> <param2>=<value2> ...
# A value containing a space must be wrapped in double quotes, e.g.
#   command="vdsl status"
# Inside quotes, \" is a literal double quote and \\ a literal backslash.
# Lines starting with # are comments
# Empty lines are ignored
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to: plugins/configs/local-presets.conf
# 2. Edit the config entries as needed
# 3. Set file permissions: chmod 600 plugins/configs/local-presets.conf
# 4. Record the approved hash: run "nest plugins hash". This computes the
#    SHA-256 of local-presets.conf and writes it as LOCAL_CONFIG_HASH in the
#    nest config file (/etc/nest/nest.conf). Alternatively set
#    "LOCAL_CONFIG_HASH=<sha256>" there by hand.
# 5. Restart Nest server
# 6. Verify in the Web UI at /help/startup-warnings/config-drift-awaiting-approval
#    (if the hash is missing or does not match)
#
# SECURITY: The actual config file (local-presets.conf) must have its SHA-256
#           recorded as LOCAL_CONFIG_HASH in the protected nest config file. This
#           example file is NOT hashed and is only for reference.

# Example: Test plugin with basic message (space in the value is quoted)
test=check-test nagiosReturnMessage="Test message" nagiosReturnValue=0 performanceData=false

# Example: Test plugin with performance data
test_perfdata=check-test nagiosReturnMessage="Test message" nagiosReturnValue=0 performanceData=true

# Example: presets opted into the unified check. The reserved parameter
# nestUnified=true marks a preset so the /unified aggregate route runs it and
# reports the worst status across all opted-in presets (one Nagios service).
# nestUnified is a directive for the aggregator, not a plugin input: it is
# stripped before the preset is dialled back into its plugin route.
# disk_root=check-disk warn=80% crit=90% nestUnified=true
# cert_expiry=check-cert-expiry nestUnified=true
