{
	"name": "nest",
	"version": "0.1.4.6",
	"description": "Nagios Rest Server",
	"main": "dist/server.js",
	"module": "ESNext",
	"scripts": {
		"build": "rm -rf dist && npx tsc",
		"build:release": "npm run build && node esbuild-bundle.mjs && node --build-sea sea-config.json && cd standalone && rm -rf nest && mv sea-prep.blob nest && rm -rf server-bundled.js",
		"build:deb": "./nvm-wrapper.sh rm -rf dist standalone/nest && ./nvm-wrapper.sh npm run build:release && cd build_deb && ./make_deb.sh && ./make_plugins_deb.sh",
		"start": "node dist/server.js",
		"dev": "NODE_ENV=development nodemon --exec tsx src/server-preload.ts --inspect",
		"dev:root": "sudo env PATH=\"$(sudo bash -c 'echo $PATH'):$PATH\" npm run dev",
		"format:check": "prettier --check .",
		"format:fix": "prettier --write --list-different .",
		"lint:check": "eslint . --report-unused-disable-directives --max-warnings 0",
		"lint:fix": "eslint . --report-unused-disable-directives --max-warnings 0 --fix",
		"test:shell": "bash scripts/check_nest.test.sh",
		"test:e2e:nmap": "bash scripts/check_honeypot_nmap.test.sh",
		"check:vulnerabilities": "npm audit --omit=dev",
		"fix:vulnerabilities": "npm audit fix --omit=dev --ignore-scripts",
		"test": "NODE_OPTIONS='--experimental-vm-modules --experimental-vm-modules' jest --watch",
		"test:ci": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand",
		"test:coverage:src": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --collectCoverageFrom='src/**/*.{ts,tsx}' --collectCoverageFrom='!src/**/*.d.ts' --collectCoverageFrom='!src/**/*.test.ts' --collectCoverageFrom='!src/**/*.spec.ts' --collectCoverageFrom='!src/**/*.test.tsx' --collectCoverageFrom='!src/**/*.spec.tsx' && npm run test:shell",
		"test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage && npm run test:shell",
		"find-untested": "tsx scripts/find-untested-files.mts",
		"typescript-app:check": "npx tsc --noEmit --project tsconfig.json",
		"typescript-plugins:check": "npx tsc --noEmit --project tsconfig.plugins.json",
		"typescript-tests:check": "npx tsc --noEmit --project tsconfig.jest.json",
		"validate": "npm run lint:check && npm run format:check && npm run typescript-app:check && npm run typescript-plugins:check && npm run typescript-tests:check && npm run test:coverage && npm run build && npm run find-untested",
		"prepare": "./nvm-wrapper.sh node .husky/install.mjs"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/some-git-user/nest.git"
	},
	"author": "Viktor Keller",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/some-git-user/nest/issues"
	},
	"homepage": "https://github.com/some-git-user/nest#readme",
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^4.3.0",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.9.1",
		"@types/sanitize-html": "^2.16.1",
		"@types/ssh2": "^1.15.5",
		"@types/supertest": "^7.2.0",
		"@typescript-eslint/eslint-plugin": "^8.38.0",
		"@typescript-eslint/parser": "^8.38.0",
		"esbuild": "0.25.11",
		"eslint": "^9.32.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-promise": "^7.2.1",
		"husky": "^9.1.7",
		"jest": "^30.2.0",
		"nodemon": "^3.1.10",
		"prettier": "3.8.1",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.6",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.23.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.38.0"
	},
	"dependencies": {
		"cors": "^2.8.5",
		"envalid": "^8.1.0",
		"express": "^5.1.0",
		"express-rate-limit": "^8.1.0",
		"helmet": "^8.1.0",
		"hpp": "^0.2.3",
		"http-errors": "^2.0.0",
		"morgan": "^1.10.1",
		"node-cron": "^4.2.1",
		"sanitize-html": "^2.17.2",
		"ssh2": "^1.17.0",
		"xss-clean": "^0.1.4"
	}
}
