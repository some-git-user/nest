#!/bin/bash
set -e

NEST_CONF="/etc/nest/nest.conf"
STAGING_DIR="/usr/share/nest-plugins"

if [ ! -f "$NEST_CONF" ]; then
    echo "Error: $NEST_CONF not found. Is the 'nest' package installed?" >&2
    exit 1
fi

# Read PLUGINS_DIR from the installed nest.conf
PLUGINS_DIR=$(grep -E '^PLUGINS_DIR=' "$NEST_CONF" | cut -d= -f2-)

if [ -z "$PLUGINS_DIR" ]; then
    echo "Error: PLUGINS_DIR not set in $NEST_CONF." >&2
    exit 1
fi

mkdir -p "$PLUGINS_DIR"

# Copy staged plugins to the configured PLUGINS_DIR
for f in "$STAGING_DIR"/*.ts; do
    [ -f "$f" ] || continue
    cp "$f" "$PLUGINS_DIR/"
done

# Create configs directory and copy config files
mkdir -p "$PLUGINS_DIR/configs"
for f in "$STAGING_DIR/configs/"*; do
    [ -f "$f" ] || continue
    cp "$f" "$PLUGINS_DIR/configs/"
done

# If local-presets.conf doesn't exist, create it from example
if [ ! -f "$PLUGINS_DIR/configs/local-presets.conf" ]; then
    if [ -f "$PLUGINS_DIR/configs/local-presets.conf.example" ]; then
        cp "$PLUGINS_DIR/configs/local-presets.conf.example" "$PLUGINS_DIR/configs/local-presets.conf"
        chmod 640 "$PLUGINS_DIR/configs/local-presets.conf"
        echo "Created local-presets.conf from example."
        echo "Edit the file and add its SHA-256 hash to plugin-whitelist.txt."
    fi
fi

echo "Plugins installed to $PLUGINS_DIR"
echo "Config files installed to $PLUGINS_DIR/configs"
