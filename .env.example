# Nest Configuration Example
# Copy this file to .env and customize as needed

# =============================================================================
# ENVIRONMENT
# =============================================================================

# Application environment mode
# Values: 'development' | 'production'
# Controls logging verbosity, error details, and security defaults
NODE_ENV=development

# =============================================================================
# SERVER
# =============================================================================

# Network interface to bind the HTTPS server to
# Use 'localhost' for local-only access, '0.0.0.0' for all interfaces
# For production, bind to specific trusted interfaces only
HOST=localhost

# Port number for the HTTPS server
# Default: 5000
PORT=5000

# =============================================================================
# TLS/SSL CERTIFICATE (HTTPS)
# =============================================================================

# Path to the TLS certificate file (public certificate)
# Required for HTTPS. Use self-signed certs for development/testing.
# Default: certs/nest-cert.pem
TLS_CERT_PATH=certs/nest-cert.pem

# Path to the TLS private key file
# Must match the certificate. Keep this file secure with restricted permissions (0600)
# Default: certs/nest-key.pem
TLS_KEY_PATH=certs/nest-key.pem

# Note: If these files don't exist, Nest will auto-generate a self-signed certificate
# with default settings (localhost, 365 days validity) on first startup.

# =============================================================================
# DIRECTORIES
# =============================================================================

# Directory containing plugin check scripts (*.ts files)
# Plugins are auto-discovered and loaded from this directory
# Default: plugins
PLUGINS_DIR=plugins

# Approved SHA-256 of the local config presets file (configs/local-presets.conf).
# The trusted hash lives here (in the protected nest.conf) rather than in the
# plugins directory. Empty means no approved hash, so the presets file is treated
# as unapproved at startup. `nest plugins hash` writes this value.
# Each plugin's own hash lives in its sidecar manifest (<name>.manifest.json).
LOCAL_CONFIG_HASH=

# Master key for encrypting secrets stored in local-presets.conf (0600, 32 bytes).
# Kept OUTSIDE the plugins directory so the admin editor - which can read and
# rewrite the presets - can never read or overwrite it. Relative paths resolve
# against the working directory.
# Default: secrets/nest.key (gitignored). The deb sets /etc/nest/nest.key.
# If the file is missing and no encrypted secrets exist yet, Nest generates one
# on startup. If it is missing while encrypted secrets remain, those presets are
# unavailable until the original key is restored - a new key cannot decrypt them.
SECRET_KEY_PATH=secrets/nest.key

# Path to the main application log file
# Logs are written in append mode with automatic rotation
# Default: logs/nest.log
LOG_FILE_PATH=logs/nest.log

# =============================================================================
# LOGGING
# =============================================================================

# Maximum size (in bytes) for a single log file before rotation occurs
# Default: 1048576 (1MB)
# Set to 0 to disable rotation (not recommended for production)
# Example: 1048576 = 1MB, 10485760 = 10MB
MAX_LOG_FILE_SIZE_BYTES=1048576

# =============================================================================
# SECURITY
# =============================================================================

# HTTP header name used for API key authentication
# Clients must send: <API_KEY_HEADER>: <API_KEY>
# Default: x-api-key
API_KEY_HEADER=x-api-key

# Shared secret API key for authentication
# Leave empty to disable API key authentication (NOT recommended for production)
# When set, all requests must include this key in the header specified by API_KEY_HEADER
# Example: API_KEY=your-secret-key-here
API_KEY=

# Comma-separated list of allowed IP addresses for access control
# Default: 127.0.0.1, ::1 (IPv4 and IPv6 loopback only)
# For remote monitoring sources, add their IPs here (e.g., "192.168.1.100, 10.0.0.50")
# Use * to allow all IP addresses (NOT recommended for production)
# Leave empty to restrict to loopback only
# NOTE: Do not mix * with specific IPs (e.g., "127.0.0.1,*" is invalid)
ALLOWED_IPS=127.0.0.1, ::1
# Honour the X-Forwarded-For header when resolving the client IP. Leave this
# disabled unless Nest runs behind a reverse proxy you control, otherwise a
# client can spoof its address and bypass ALLOWED_IPS.
# Values: false (default), true (trust every peer), a number of proxy hops,
# or a comma-separated list of trusted proxy IPs/CIDRs.
TRUST_PROXY=false

# =============================================================================
# RATE LIMITING
# =============================================================================

# Time window (in milliseconds) for rate limit counting
# Default: 60000 (60 seconds)
# Requests are counted within this sliding window
RATE_LIMIT_WINDOW_MS=60000

# Maximum number of requests allowed per window per IP
# Default: 120 requests per 60 seconds (2 requests/second average)
# Set to 0 to disable rate limiting (NOT recommended for production)
# Adjust based on your monitoring frequency and server capacity
RATE_LIMIT_MAX=120

# =============================================================================
# ADMIN UI (local config editor)
# =============================================================================

# The UI is always mounted under /admin and can rewrite configs/local-presets.conf.
# It never changes the approved hash: saving changes the file's hash, the running
# presets stay the approved ones, and a drift banner shows the exact
# "LOCAL_CONFIG_HASH=<sha256>" line to set here, followed by a restart.
# Without ADMIN_UI_PASSWORD the UI serves a "not configured" help page instead.

# Admin password protecting the UI (separate from API_KEY)
# Leave empty to keep the UI locked: it renders a "not configured" page and a
# startup warning. Set a strong secret to enable login.
# Example: ADMIN_UI_PASSWORD=your-admin-secret
ADMIN_UI_PASSWORD=

# Lifetime (in seconds) of an admin session cookie
# Default: 900 (15 minutes)
ADMIN_SESSION_TTL_SECONDS=900

# Maximum number of login attempts per window per IP
# Default: 5
# Login is the only unauthenticated write endpoint, so it gets a much tighter
# bucket than RATE_LIMIT_MAX. The window is RATE_LIMIT_WINDOW_MS.
ADMIN_LOGIN_RATE_LIMIT_MAX=5

# Maximum number of admin plugin TEST runs per window per IP
# Default: 20
# Each successful /admin/api/test spawns a real plugin process as the service
# user. The auth rate limiter ignores successes, so this counter covers the
# spawn path. Loose enough for a human clicking Test in the editor.
ADMIN_TEST_RATE_LIMIT_MAX=20

# =============================================================================
# UNIFIED CHECK
# =============================================================================

# Per-preset timeout (in milliseconds) for the /unified aggregate check.
# Default: 15000 (15 seconds)
# The unified check dials every opted-in preset in parallel and waits for all of
# them. A preset that exceeds this timeout is reported as UNKNOWN instead of
# stalling the whole aggregate. Keep it below the internal client's own 30s cap.
UNIFIED_TIMEOUT_MS=15000

# =============================================================================
# HONEYPOT
# =============================================================================

# Drop TLS/HTTP protocol errors (clientError/tlsClientError) whose peer address
# is loopback (127.0.0.0/8 or ::1) instead of recording them as honeypot probes.
# Default: true
# A browser on the same host keeps speculative TLS sockets and discards them once
# the real request lands, and Node reports a socket torn down before a full
# request exactly like a scanner probe. Without this, browsing the admin UI from
# the host itself raises false port-scan alerts attributed to the host.
# Set to false to record loopback probes too: correct when Nest sits behind a
# same-host reverse proxy, where every external probe arrives from loopback.
HONEYPOT_IGNORE_LOOPBACK_PROBES=true
